generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// =========================
/// USERS TABLE
/// =========================
model users {
  id            BigInt     @id @default(autoincrement())
  email         String?     @db.Text
  password_hash String?     @db.Text
  full_name     String?     @db.Text
  created_at    DateTime?   @db.Timestamptz(6)
  updated_at    DateTime?   @db.Timestamptz(6)

  // Relations
  holdings      holdings[]
  orders        orders[]
  watchlists    watchlists[]

  @@map("users") // Maps Prisma model → Supabase table
}

/// =========================
/// HOLDINGS TABLE
/// =========================
model holdings {
  id         BigInt   @map("id")
  user_id    BigInt
  symbol     String?  @db.Text
  quantity   BigInt?  
  avg_cost   Float?   @db.DoublePrecision
  created_at DateTime? @db.Timestamptz(6)

  // Composite primary key
  @@id([id, user_id])

  // Relations
  user users @relation(fields: [user_id], references: [id])

  @@map("holdings")
}

/// =========================
/// ORDERS TABLE
/// =========================
model orders {
  id         BigInt   @map("id")
  user_id    BigInt
  symbol     String?  @db.Text
  type       String?  @db.Text
  quantity   BigInt?
  price      Float?   @db.DoublePrecision
  status     String?  @db.Text
  created_at DateTime? @db.Timestamptz(6)

  // Composite primary key
  @@id([id, user_id])

  // Relations
  user users @relation(fields: [user_id], references: [id])

  @@map("orders")
}

/// =========================
/// WATCHLIST TABLE
/// =========================
model watchlists {
  id         BigInt   @map("id")
  user_id    BigInt
  symbol     String?  @db.Text
  created_at DateTime? @db.Timestamptz(6)

  // Composite primary key
  @@id([id, user_id])

  // Relations
  user users @relation(fields: [user_id], references: [id])

  @@map("watchlists")
}

/// =========================
/// SYMBOL CATALOG
/// =========================
model symbol_catalog {
  id         BigInt    @id @default(autoincrement())
  symbol     String    @unique @db.Text
  name       String    @db.Text
  exchange   String    @db.Text
  type       String?   @db.Text
  country    String?   @db.Text
  is_active  Boolean   @default(true)
  updated_at DateTime? @db.Timestamptz(6)

  @@index([symbol])
  @@index([name])
  @@index([exchange])
  @@map("symbol_catalog")
}

/// =========================
/// ANALYSIS RUN
/// =========================
model analysis_run {
  id               BigInt    @id @default(autoincrement())
  symbol           String    @db.Text
  analysis_date    DateTime  @db.Date
  pipeline_version String    @db.Text
  status           String    @db.Text // QUEUED, RUNNING, SUCCESS, PARTIAL, INSUFFICIENT_DATA, FAILED
  started_at       DateTime? @db.Timestamptz(6)
  completed_at     DateTime? @db.Timestamptz(6)
  error            String?   @db.Text
  metadata         Json?

  // Relations
  results          analysis_result[]

  // Unique constraint for idempotency
  @@unique([symbol, analysis_date, pipeline_version])
  @@map("analysis_run")
}

/// =========================
/// ANALYSIS RESULT
/// =========================
model analysis_result {
  id                  BigInt    @id @default(autoincrement())
  analysis_run_id     BigInt
  symbol              String    @db.Text
  analysis_date       DateTime  @db.Date
  
  market_context      Json?
  technical_context   Json?
  fundamental_context Json?
  news_context        Json?
  model_outputs       Json?
  forecast            Json?
  llm_context         Json?
  llm_output          Json?
  data_quality        Json?

  // Relations
  run analysis_run @relation(fields: [analysis_run_id], references: [id])

  @@unique([symbol, analysis_date])
  @@map("analysis_result")
}
